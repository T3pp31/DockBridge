    "Connection profiles could not be decrypted. The encrypted store or its Keychain master key may be corrupt. Remove ~/Library/Application Support/DockBridge/profiles.json and recreate profiles, or restore both profiles.json and Keychain items from backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection profiles could not be decrypted. The encrypted store or its Keychain master key may be corrupt. Remove ~/Library/Application Support/DockBridge/profiles.json and recreate profiles, or restore both profiles.json and Keychain items from backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続プロファイルを復号できませんでした。暗号化された保存データまたは Keychain のマスター鍵が破損している可能性があります。~/Library/Application Support/DockBridge/profiles.json を削除してプロファイルを作り直すか、profiles.json と Keychain 項目の両方をバックアップから復元してください。"
          }
        }
      }
    },
    "Connection profiles were created by a newer version of DockBridge and cannot be read by this build. Update the app instead of deleting profiles.json. (%@)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
