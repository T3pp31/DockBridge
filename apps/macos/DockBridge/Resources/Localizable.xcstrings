    "The host key for %@:%@ has changed. This may indicate a man-in-the-middle attack. Verify the new fingerprint with the server administrator before accepting.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host key for %@:%@ has changed. This may indicate a man-in-the-middle attack. Verify the new fingerprint with the server administrator before accepting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$@ のホスト鍵が変更されました。中間者攻撃の可能性があります。承認する前に、新しいフィンガープリントをサーバー管理者へ確認してください。"
          }
        }
      }
    },
    "The name cannot be '.'/'..' or contain '/' or null characters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name cannot be '.'/'..' or contain '/' or null characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を「.」または「..」にすることや、「/」またはヌル文字を含めることはできません。"
          }
        }
      }
    },
    "The profile \"%@\" now points to %@. It previously used %@. If you did not make this change, restore the previous endpoint.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile \"%@\" now points to %@. It previously used %@. If you did not make this change, restore the previous endpoint."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル「%1$@」の接続先が %2$@ に変更されています。以前は %3$@ を使用していました。この変更に心当たりがない場合は、以前の接続先へ戻してください。"
          }
        }
      }
    },
    "This connection uses an RSA private key. RSA key authentication may be vulnerable to timing attacks (Marvin Attack). Prefer Ed25519 or ECDSA keys when possible.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection uses an RSA private key. RSA key authentication may be vulnerable to timing attacks (Marvin Attack). Prefer Ed25519 or ECDSA keys when possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続では RSA 秘密鍵を使用します。RSA 鍵認証はタイミング攻撃（Marvin Attack）の影響を受ける可能性があります。可能であれば Ed25519 または ECDSA 鍵を使用してください。"
          }
        }
      }
    },
