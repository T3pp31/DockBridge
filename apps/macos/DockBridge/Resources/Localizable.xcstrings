    "The sandboxed app cannot read ~/.ssh/known_hosts directly. Select your OpenSSH known_hosts file here to merge trusted keys before connecting. @cert-authority entries are imported but not used for host trust.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sandboxed app cannot read ~/.ssh/known_hosts directly. Select your OpenSSH known_hosts file here to merge trusted keys before connecting. @cert-authority entries are imported but not used for host trust."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンドボックス化されたアプリは ~/.ssh/known_hosts を直接読み取れません。接続前に信頼するキーをマージするため、ここで OpenSSH known_hosts ファイルを選択してください。@cert-authority エントリはインポートされますが、ホストの信頼には使用されません。"
          }
        }
      }
    },
