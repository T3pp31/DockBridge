+    /// Atomically replaces `newpath` with `oldpath` via the
+    /// `posix-rename@openssh.com` extension. Unlike a plain rename, this
+    /// succeeds when `newpath` already exists as a regular file.
+    /// Returns `Ok(false)` if the remote SFTP server does not support
+    /// `posix-rename@openssh.com` extension v1.
+    pub async fn posix_rename<O, N>(&self, oldpath: O, newpath: N) -> SftpResult<bool>
+    where
+        O: Into<String>,
+        N: Into<String>,
+    {
+        if !self.features.posix_rename {
+            return Ok(false);
+        }
+
+        self.session
+            .posix_rename(oldpath, newpath)
+            .await
+            .map(|_| true)
     }
 
